include LICENSE
include README.md
include pyproject.toml
recursive-include zeroproof.simulations *.py
recursive-include zeroproof *.py
recursive-include zeroproof_simulations *.py
include zeroproof/py.typed
include zeroproof/simulations/py.typed
recursive-include zeroproof/simulations/schemas *.json
prune zeroproof/simulations/_experimental
prune zeroproof/simulations/behaviors
prune tests
prune examples
prune specs
prune docs
global-exclude *.ipynb *.py[cod] .DS_Store
